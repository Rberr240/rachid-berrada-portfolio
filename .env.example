# Modèle de variables d'environnement — aucune valeur réelle ici.
# En production, les définir dans Netlify (Project configuration → Environment variables).

# URL canonique, sans slash final. Défaut si vide : https://rachidberrada.com
NEXT_PUBLIC_SITE_URL=

# Le numéro de téléphone/WhatsApp n'est PAS configurable par variable :
# il vient uniquement de src/content/facts.ts.

# Webhook Make appelé uniquement côté serveur par netlify/functions/lead-automation.mts.
# Ne jamais committer de vraie valeur. Vide = automatisation désactivée
# (la soumission Netlify Forms n'est jamais affectée).
LEADS_AUTOMATION_WEBHOOK_URL=

# Mesure d'audience Plausible (sans cookie). Laisser vide tant que le compte,
# la CSP (netlify.toml) et la politique de confidentialité ne sont pas prêts.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
