# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# scripts de QA temporaires (captures Playwright, audits ponctuels...) —
# jamais destinés à être commités, uniquement utilisés puis supprimés en session
/qa*.mjs
/qa*.json
/shot.mjs
*.tmp

# env files — .env.example reste versionné (c'est un template, pas un secret)
.env*
!.env.example

# vercel
.vercel

# outillage local (non lié au site)
.claude/

# typescript
*.tsbuildinfo
next-env.d.ts
