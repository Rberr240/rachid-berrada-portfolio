# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# scripts de QA temporaires (captures Playwright, audits ponctuels...) —
# jamais destinés à être commités, uniquement utilisés puis supprimés en session
/qa*.mjs
/qa*.json
/shot.mjs
*.tmp

# env files — .env.example reste versionné (c'est un template, pas un secret)
.env*
!.env.example

# vercel
.vercel

# assets sources bruts (originaux non retouchés, référence artistique) —
# jamais publiés tels quels ; seuls les fichiers copiés dans public/images/rachid/
# sont utilisés par le site
/public/images/rachid/incoming/

# outillage local (non lié au site)
.claude/
AGENTS.md
CLAUDE.md

# documents internes de gouvernance/sécurité/audit — utiles en local,
# volontairement absents du repository public professionnel
SECURITY_INCIDENT_REPORT.md
SECRET_ROTATION_PLAN.md
GIT_HISTORY_CLEANUP_PLAN.md
PRE_REWRITE_BACKUP_CHECKLIST.md
SECURITY_REMEDIATION_READINESS_REPORT.md
SECURITY_REWRITE_DRY_RUN_REPORT.md
SECURITY_HISTORY_REWRITE_FINAL_REPORT.md
PROFESSIONALIZATION_REPORT.md
FINAL_PROFESSIONALIZATION_REPORT.md
PUBLICATION_READINESS_REPORT.md
PORTFOLIO_GITHUB_AUDIT.md
GITHUB_PROFILE_STRATEGY.md
GITHUB_PROFILE_README_DRAFT.md
BUSINESS_CARD_QR_PLAN.md
DOMAIN_SETUP_GUIDE.md

# typescript
*.tsbuildinfo
next-env.d.ts
